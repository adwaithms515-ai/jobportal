PORT=5000
MONGODB_URI=mongodb://localhost:27017/jobportal
JWT_SECRET=supersecretjwtkey_change_this_in_production
JWT_REFRESH_SECRET=supersecretjwtrefreshkey_change_this_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Elasticsearch configuration (optional - fallbacks to MongoDB search if empty or unreachable)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# File Storage Configuration (optional - fallbacks to local storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service Configuration (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@jobportal.com
FROM_NAME="Job Portal Team"

# Frontend URL (for CORS and reset links)
FRONTEND_URL=http://localhost:5173
